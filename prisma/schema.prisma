datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  SELLER
  ADMIN
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  password         String
  role             Role      @default(CLIENT)
  verificationCode String?
  otpExpiresAt     DateTime?
  isVerified       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  garments        Garment[]
  auditLogs       AuditLog[]       @relation("AdminActions")
  userRoles       UserRole[]
  userPermissions UserPermission[]
}

model Garment {
  id            String   @id @default(cuid())
  name          String
  category      String   // 'tops', 'bottoms', 'shoes', 'outerwear'
  vibe          String?
  url           String   @db.Text // Vital para base64 o URLs de imágenes
  price         String?
  storeUrl      String?
  description   String?
  vendorName    String?
  vendorContact String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  action    String   // Ej: "UPDATE_USER_ROLE", "DELETE_GARMENT"
  target    String   // ID o correo afectado
  details   String?  // Descripción o metadatos de la acción
  createdAt DateTime @default(now())
}

// --- MODELOS DE ROLES Y PERMISOS RBAC ---

model RoleModel {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  userRoles   UserRole[]
  createdAt   DateTime   @default(now())
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now())
}

model UserRole {
  id     String    @id @default(uuid())
  userId String
  roleId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}